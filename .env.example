NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio. Unset = alerts are logged and skipped, never fatal.
# Free/trial and unregistered numbers only deliver pre-cleared bodies, so
# the app always sends the fixed ALERT_BODY string in src/lib/scan.ts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Shared number public-tier scanners dial; the IVR bridges by 4-digit code.
TWILIO_MASK_NUMBER=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email allowed to review responder org applications at /admin/responders.
# Unset = the review endpoints refuse everyone.
RESQ_ADMIN_EMAIL=
