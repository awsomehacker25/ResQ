NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio. Unset = alerts are logged and skipped, never fatal.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Shared number public-tier scanners dial; the IVR bridges by 4-digit code.
TWILIO_MASK_NUMBER=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Timezone the alert SMS prints its timestamp in. Default: America/Chicago
RESQ_TZ=America/Chicago
